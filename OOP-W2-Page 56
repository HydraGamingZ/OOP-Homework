#include <iostream>
#include <vector>
#include <string>

struct Product {
    int id;
    std::string name;
    double price;
};

// -Catalog-
class Catalog {
private:
    std::vector<Product> products;

public:
    void load() {
        products.push_back({1, "Apple", 0.5});
        products.push_back({2, "Bread", 1.5});
        products.push_back({3, "Milk", 2.0});
        products.push_back({4, "Chocolate", 1.0});
    }

    Product* find(int id) {
        for (auto &p : products) {
            if (p.id == id) return &p;
        }
        return nullptr;
    }
};

// -Cart-
class Cart {
private:
    std::vector<int> ids;
    std::vector<int> qty;

public:
    void add(int id, int quantity) {
        for (size_t i = 0; i < ids.size(); i++) {
            if (ids[i] == id) {
                qty[i] += quantity;
                return;
            }
        }
        ids.push_back(id);
        qty.push_back(quantity);
    }

    const std::vector<int>& getIds() const { return ids; }
    const std::vector<int>& getQty() const { return qty; }
};

//-Checkout-
class Checkout {
private:
    Catalog& catalog;
    Cart& cart;
    double taxRate;

public:
    Checkout(Catalog& c, Cart& ca, double tax)
        : catalog(c), cart(ca), taxRate(tax) {}

    double computeSubtotal() {
        double sum = 0.0;

        auto ids = cart.getIds();
        auto qty = cart.getQty();

        for (size_t i = 0; i < ids.size(); i++) {
            Product* p = catalog.find(ids[i]);
            if (p) sum += p->price * qty[i];
        }
        return sum;
    }

    double applyDiscount(double subtotal) {
        return (subtotal > 10.0) ? subtotal * 0.9 : subtotal;
    }

    void printReceipt() {
        std::cout << "---- Receipt ----\n";

        auto ids = cart.getIds();
        auto qty = cart.getQty();

        for (size_t i = 0; i < ids.size(); i++) {
            Product* p = catalog.find(ids[i]);
            if (!p) continue;

            std::cout << p->name << " x" << qty[i]
                      << " @ " << p->price
                      << " = " << (p->price * qty[i]) << "\n";
        }

        double subtotal = computeSubtotal();
        double discounted = applyDiscount(subtotal);
        double tax = discounted * taxRate;
        double total = discounted + tax;

        std::cout << "Subtotal: " << subtotal << "\n";
        std::cout << "Discounted: " << discounted << "\n";
        std::cout << "Tax: " << tax << "\n";
        std::cout << "Total: " << total << "\n";
    }
};

int main() {
    Catalog catalog;
    Cart cart;

    catalog.load();

    cart.add(1, 4);
    cart.add(2, 1);
    cart.add(4, 3);

    Checkout checkout(catalog, cart, 0.07);
    checkout.printReceipt();

    return 0;
}
